<?xml version="1.0" encoding="utf-8"?>
<!-- Tela da lista. Etapa visual (Grupo 5): sem cores fixas, com estilos do tema.
     Os IDs usados no TaskListActivity.kt (mainTaskList, etTaskInput, btnAdd, rvTasks, tvEmpty)
     e os tipos das Views foram mantidos. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainTaskList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TaskListActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="@string/title_tasks"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewTask"
        style="@style/Widget.Oficina_Android.CampoTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:hint="@string/hint_new_task"
        app:layout_constraintEnd_toStartOf="@id/btnAdd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnAdd"
        style="@style/Widget.Oficina_Android.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/btn_add"
        app:layout_constraintBottom_toBottomOf="@id/tilNewTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tilNewTask" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilNewTask"
        tools:itemCount="3"
        tools:listitem="@layout/item_task" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Widget.Oficina_Android.TextoApoio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_tasks"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvTasks"
        app:layout_constraintEnd_toEndOf="@id/rvTasks"
        app:layout_constraintStart_toStartOf="@id/rvTasks"
        app:layout_constraintTop_toTopOf="@id/rvTasks" />

</androidx.constraintlayout.widget.ConstraintLayout>
