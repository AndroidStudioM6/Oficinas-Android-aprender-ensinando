<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- Tela inicial (Fragment Home) -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.oficina_android.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/nav_add_task"
        android:name="com.example.oficina_android.AddTaskFragment"
        android:label="@string/nav_add_task">
        <argument
            android:name="FOCUS_ADD"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/nav_task_list"
        android:name="com.example.oficina_android.TaskListFragment"
        android:label="@string/nav_task_list" />

    <fragment
        android:id="@+id/nav_about"
        android:name="com.example.oficina_android.AboutFragment"
        android:label="@string/nav_about" />

</navigation>
