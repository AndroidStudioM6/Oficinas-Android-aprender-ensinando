<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- Tela inicial (Fragment Home) -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.oficina_android.HomeFragment"
        android:label="@string/nav_home" />

    <!--
        Destinos das telas funcionais.
        A equipe de Fragments poderá posteriormente trocar a tag <activity> por <fragment>
        sem precisar alterar a estrutura do menu ou do MainActivity.
    -->
    <activity
        android:id="@+id/nav_add_task"
        android:name="com.example.oficina_android.TaskListActivity"
        android:label="@string/nav_add_task">
        <argument
            android:name="FOCUS_ADD"
            android:defaultValue="true"
            app:argType="boolean" />
    </activity>

    <activity
        android:id="@+id/nav_task_list"
        android:name="com.example.oficina_android.TaskListActivity"
        android:label="@string/nav_task_list" />

    <activity
        android:id="@+id/nav_about"
        android:name="com.example.oficina_android.AboutActivity"
        android:label="@string/nav_about" />

</navigation>
